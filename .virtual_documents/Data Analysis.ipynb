# Categorical
weekday = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']


df['Hire_Day'] = pd.Categorical(df['Hire_Day'], categories=weekday)


df


df['Hire_Day']


