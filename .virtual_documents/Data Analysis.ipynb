


'''
Group by -> grouping result in single set
Aggregate Functions -> mean, sum, max, min, count
'''


# Aggregate Functions -> mean (average), sum, max, min, count
# KPI (Key Performance Indicator)


import pandas as pd


df = pd.read_csv('Employees.csv')
df.head()


commission_mean = df['COMMISSION_PCT'].mean()
com_mean = "{:.2f}".format(commission_mean)


df['COMMISSION_PCT'] = df['COMMISSION_PCT'].fillna(com_mean)


mgr_mode = df['MANAGER_ID'].mode()
mgr_mode


df['MANAGER_ID'] = df['MANAGER_ID'].fillna(mgr_mode)


dep_mode = df['DEPARTMENT_ID'].mode()
dep_mode


df['DEPARTMENT_ID'] = df['DEPARTMENT_ID'].fillna(50.0)


df['DEPARTMENT_ID']


df.isnull().sum()


df.head()


# Find average, max, min, total salary of employees
mean_salary = df['SALARY'].mean()
print(mean_salary)


max_salary = df['SALARY'].max()
print(max_salary)


min_salary = df['SALARY'].min()
print(min_salary)


total_salary = df['SALARY'].sum()
print(total_salary)


count_salary = df['SALARY'].count()
print(count_salary)


# Find total number of employees in each department.
# df.groupby(column_name)[column_name].count()
emp_dep = df.groupby('DEPARTMENT_ID')['EMPLOYEE_ID'].count().reset_index()
emp_dep


# Find total number of employees according to Job
job_emp = df.groupby('JOB_ID')['EMPLOYEE_ID'].count().reset_index()
job_emp


# Find total salary of employees according to Job.
job_sal = df.groupby('JOB_ID')['SALARY'].sum().reset_index()
job_sal


# Find total number of Job available in each Departments.
dep_job = df.groupby('DEPARTMENT_ID')['JOB_ID'].count().reset_index()
dep_job





# Find average and total salary of employees by job
salary_details = df.groupby('JOB_ID').agg(
    average_salary = ('SALARY', 'mean'),
    total_salary = ('SALARY', 'sum'),
    max_salary = ('SALARY', 'max'),
    min_salary = ('SALARY', 'min')
).reset_index()
salary_details


salary_details = df.groupby('JOB_ID')['SALARY'].agg(
    average_salary = ('mean'),
    total_salary = ('sum'),
    max_salary = ('max'),
    min_salary = ('min')
).reset_index()
salary_details





# Average transaction per device
fraud = pd.read_csv('Cleaned_Fraud_Dataset.csv')
fraud.head()


device_transaction = fraud.groupby('Device_Used')['Transaction_Amount'].mean().reset_index()
device_transaction


# Highest transaction per each transaction type
max_transaction = fraud.groupby('Transaction_Type')['Transaction_Amount'].max().reset_index()
max_transaction


df.head()


df.info()


df['COMMISSION_PCT'] = df['COMMISSION_PCT'].astype(float)


# find total salary and average commision earned by each department
department_earned = df.groupby('DEPARTMENT_ID').agg(
    total_salary = ('SALARY', 'sum'),
    avg_commission = ('COMMISSION_PCT', 'mean')
).reset_index()
department_earned


# Find total salary of employees distributed by department and its job.
dep_job_sal = df.groupby(['JOB_ID', 'DEPARTMENT_ID'])['SALARY'].sum().reset_index()
dep_job_sal


'''
Find total salary and maximum salary, total commision of 
employees distributed by department and its job.
'''
# df.to_csv('')
sal_com_dep_job = df.groupby(['JOB_ID', 'DEPARTMENT_ID']).agg(
    total_sal = ('SALARY', 'sum'),
    max_sal = ('SALARY', 'max'),
    total_commission = ('COMMISSION_PCT', 'sum')
).reset_index()
sal_com_dep_job


'''
Find total salary of employees distributed by department and its job 
where salary must be more than 20000.
job id must be in AD_PRES/AD_VP/IT_PROG
'''
dep_job_sal = df.groupby(['JOB_ID', 'DEPARTMENT_ID'])['SALARY'].sum().reset_index()
filter_data = dep_job_sal['SALARY'] > 20000


dep_job_sal[filter_data]


dep_job_sal = df.groupby(['JOB_ID', 'DEPARTMENT_ID'])['SALARY'].sum().reset_index()
filter_data = (dep_job_sal['SALARY'] > 20000) & (dep_job_sal['JOB_ID'].isin(['AD_PRES', 'AD_VP', 'IT_PROG']))
dep_job_sal[filter_data]


