emp_hire_month


pz = pd.read_csv('pizza_sales.csv')
pz.head()


# pz['Order_Hour'] = pz['order_time'].dt.hour


total_revenue = pz['total_price'].sum()
print(f"Total Revenue Collection: ${total_revenue:,.2f}")


total_pizza_sold = pz['quantity'].sum()
